{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "HĐHS DHT Web Brand",
    "version": "1.0.0",
    "updated": "2026-09-30",
    "note": "Digital sub-brand for HĐHS DHT. Not a replacement for the school's official identity."
  },
  "color": {
    "green": {
      "50": "#F2F8F5", "100": "#E1F0E9", "200": "#C4E1D3", "300": "#96C9B0",
      "400": "#62AA88", "500": "#3A8A6B", "600": "#256E54", "700": "#195744",
      "800": "#164638", "900": "#133A30", "950": "#0A211A"
    },
    "stone": {
      "0": "#FFFFFF", "50": "#F8F9F7", "100": "#F1F3F0", "200": "#E1E5E1",
      "300": "#CBD1CC", "400": "#9CA69F", "500": "#6F7A73", "600": "#515C55",
      "700": "#3B443E", "800": "#252C28", "900": "#171C19", "950": "#0C0F0D"
    },
    "accent": {
      "amber": "#C77A22",
      "blue": "#3569A8",
      "coral": "#C85C52"
    }
  },
  "semantic": {
    "canvas": "{color.stone.50}",
    "surface": "{color.stone.0}",
    "text": "{color.stone.900}",
    "textMuted": "{color.stone.500}",
    "border": "{color.stone.200}",
    "primary": "{color.green.700}",
    "primaryHover": "{color.green.900}",
    "primarySoft": "{color.green.100}",
    "info": "{color.accent.blue}",
    "warning": "{color.accent.amber}",
    "danger": "{color.accent.coral}"
  },
  "font": {
    "sans": "Geist Variable, Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
  },
  "radius": {
    "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "pill": "999px"
  },
  "motion": {
    "fast": "120ms", "base": "180ms", "slow": "260ms",
    "ease": "cubic-bezier(.2,.8,.2,1)"
  }
}
